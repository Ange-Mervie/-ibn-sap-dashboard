# ============================================================
# Variables d'environnement — IBN SAP Dashboard
# Copiez ce fichier vers .env.local (local) ou configurez dans Vercel (prod)
# ============================================================

# ------------------------------------------------------------
# BASE DE DONNÉES — PlanetScale (MySQL serverless, gratuit)
# ------------------------------------------------------------
# 1. Créez un compte sur https://planetscale.com
# 2. Créez une database (ex: ibn-dashboard)
# 3. Connect → "Prisma" ou "Generic" → copiez l'URL
# Format PlanetScale: mysql://user:pass@host/db?sslaccept=strict
DATABASE_URL=

# ------------------------------------------------------------
# SESSION SECRET — 32+ caractères aléatoires (OBLIGATOIRE)
# ------------------------------------------------------------
# Générez avec : openssl rand -base64 32
SESSION_SECRET=

# ------------------------------------------------------------
# API WRITE TOKEN (optionnel) — protège les écritures API
# ------------------------------------------------------------
API_WRITE_TOKEN=

# ------------------------------------------------------------
# GMAIL OAUTH (optionnel) — synchronisation emails
# ------------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# Redirect URI: https://VOTRE-DOMAINE.vercel.app/api/gmail/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
GMAIL_SYNC_LABEL=SAP
GMAIL_SENDER_DOMAINS=
GMAIL_SUBJECT_KEYWORDS=